{
  "author": "Richard Lindhout <info@webridge.nl> (https://github.com/web-ridge)",
  "bugs": {
    "url": "https://github.com/web-ridge/react-native-paper-dates/issues"
  },
  "description": "Performant Date Picker for React Native Paper",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10",
    "eslint-plugin-react-hooks": "7",
    "jest": "^30.5.2",
    "lefthook": "^2.2.4",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-plugin-react-native": "^0.2.46",
    "pod-install": "^1.1.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-paper": "^6.0.0-alpha.4",
    "react-native-reanimated": "^4.8.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.14.0",
    "release-it": "^21.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0"
  },
  "exports": {
    ".": {
      "react-native": "./lib/module/index.js",
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/commonjs/index.js"
    },
    "./translations/*": {
      "react-native": "./src/translations/*.ts",
      "source": "./src/translations/*.ts",
      "import": {
        "types": "./lib/typescript/module/translations/*.d.ts",
        "default": "./lib/module/translations/*.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/translations/*.d.ts",
        "default": "./lib/commonjs/translations/*.js"
      },
      "default": "./lib/commonjs/translations/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/__tests__",
    "!lib/typescript/**/example",
    "lib",
    "src"
  ],
  "homepage": "https://github.com/web-ridge/react-native-paper-dates#readme",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "license": "MIT",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "name": "react-native-paper-dates",
  "packageManager": "bun@1.4.3",
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-paper": ">=6.0.0-alpha.0 <7",
    "react-native-reanimated": ">=4.3.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-worklets": ">=0.8.1"
  },
  "react-native": "lib/module/index.js",
  "react-native-builder-bob": {
    "output": "lib",
    "source": "src",
    "targets": [
      [
        "commonjs",
        {
          "configFile": "./babel.bob.config.js",
          "esm": true
        }
      ],
      [
        "module",
        {
          "configFile": "./babel.bob.config.js",
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "./node_modules/.bin/tsc"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "repository": "https://github.com/web-ridge/react-native-paper-dates",
  "scripts": {
    "bootstrap": "bun install --cwd example && bun install && bun run pods",
    "build-example": "cd example && bunx expo export --platform web",
    "example": "bun --cwd example",
    "compiler:check": "eslint src --max-warnings 0",
    "format": "oxfmt \"**/*.{js,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{js,ts,tsx}\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pods": "cd example && pod-install --quiet",
    "prepack": "bob build",
    "prepare": "lefthook install",
    "release": "release-it --ci --github.autoGenerate",
    "test": "jest --watchAll=false",
    "test-watch": "jest --watchAll",
    "typecheck": "tsc --noEmit"
  },
  "source": "src/index",
  "types": "lib/typescript/commonjs/index.d.ts",
  "version": "0.24.2"
}
