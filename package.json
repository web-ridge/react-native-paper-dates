{
  "author": "Richard Lindhout <info@webridge.nl> (https://github.com/web-ridge)",
  "bugs": {
    "url": "https://github.com/web-ridge/react-native-paper-dates/issues"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "color": "^5.0.3"
  },
  "description": "Performant Date Picker for React Native Paper",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/config-conventional": "^21.2.4",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/color": "^4.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "~19.3.1",
    "babel-loader": "^10.1.1",
    "caniuse-lite": "^1.0.30001823",
    "commitlint": "^21.2.4",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-react-native": "^0.2.43",
    "pod-install": "^1.1.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-paper": "^6.0.0-alpha.2",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.13.1",
    "react-test-renderer": "19.3.1",
    "release-it": "^21.1.2",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9.3"
  },
  "files": [
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/__tests__",
    "!lib/typescript/example",
    "lib",
    "src"
  ],
  "homepage": "https://github.com/web-ridge/react-native-paper-dates#readme",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "license": "MIT",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "name": "react-native-paper-dates",
  "packageManager": "bun@1.4.3",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-paper": ">=6.0.0-alpha.0 <7",
    "react-native-reanimated": ">=4.3.0",
    "react-native-safe-area-context": "*"
  },
  "react-native": "src/index",
  "react-native-builder-bob": {
    "output": "lib",
    "source": "src",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "./node_modules/.bin/tsc"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "publishArgs": [
        "--registry=https://registry.npmjs.org/"
      ],
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "repository": "https://github.com/web-ridge/react-native-paper-dates",
  "scripts": {
    "bootstrap": "bun install --cwd example && bun install && bun run pods",
    "build-example": "cd example && bunx expo export --platform web",
    "example": "bun --cwd example",
    "format": "oxfmt \"**/*.{js,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{js,ts,tsx}\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pods": "cd example && pod-install --quiet",
    "prepack": "bob build",
    "prepare": "lefthook install && bob build",
    "release": "release-it --ci --github.autoGenerate",
    "test": "jest --config=jest.config.js --watchAll=false",
    "test-watch": "jest --config=jest.config.js --watchAll",
    "typecheck": "tsc --noEmit"
  },
  "source": "src/index",
  "types": "lib/typescript/index.d.ts",
  "version": "0.24.2"
}
