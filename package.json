{
  "author": "Richard Lindhout <info@webridge.nl> (https://github.com/web-ridge)",
  "bugs": {
    "url": "https://github.com/web-ridge/react-native-paper-dates/issues"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "description": "Performant Date Picker for React Native Paper",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/config-conventional": "^21.2.4",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "~19.3.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "commitlint": "^21.2.4",
    "eslint": "10",
    "eslint-plugin-react-hooks": "7",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-react-native": "^0.2.44",
    "pod-install": "^1.1.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-paper": "^6.0.0-alpha.3",
    "react-native-reanimated": "^4.7.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.13.1",
    "react-test-renderer": "19.3.1",
    "release-it": "^21.1.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "exports": {
    ".": {
      "react-native": "./lib/module/index.js",
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./translations/*": {
      "react-native": "./src/translations/*.ts",
      "source": "./src/translations/*.ts",
      "types": "./lib/typescript/translations/*.d.ts",
      "import": "./lib/module/translations/*.js",
      "require": "./lib/commonjs/translations/*.js",
      "default": "./lib/commonjs/translations/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/__tests__",
    "!lib/typescript/example",
    "lib",
    "src"
  ],
  "homepage": "https://github.com/web-ridge/react-native-paper-dates#readme",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "license": "MIT",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "name": "react-native-paper-dates",
  "packageManager": "bun@1.4.3",
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-paper": ">=6.0.0-alpha.0 <7",
    "react-native-safe-area-context": ">=5.0.0"
  },
  "react-native": "lib/module/index.js",
  "react-native-builder-bob": {
    "output": "lib",
    "source": "src",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "./node_modules/.bin/tsc"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "publishArgs": [
        "--registry=https://registry.npmjs.org/"
      ],
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "repository": "https://github.com/web-ridge/react-native-paper-dates",
  "scripts": {
    "bootstrap": "bun install --cwd example && bun install && bun run pods",
    "build-example": "cd example && bunx expo export --platform web",
    "example": "bun --cwd example",
    "compiler:check": "eslint src --max-warnings 0",
    "format": "oxfmt \"**/*.{js,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{js,ts,tsx}\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pods": "cd example && pod-install --quiet",
    "prepack": "bob build",
    "prepare": "lefthook install",
    "release": "release-it --ci --github.autoGenerate",
    "test": "jest --config=jest.config.js --watchAll=false",
    "test-watch": "jest --config=jest.config.js --watchAll",
    "typecheck": "tsc --noEmit"
  },
  "source": "src/index",
  "types": "lib/typescript/index.d.ts",
  "version": "0.24.2"
}
